<div class="wrapper">
    <h1>Hola, {{user.name}} {{user.last_name}}!!!!!</h1>
    {{#if isAdmin}}
        {{#each food}}
            <div class="product">
                <p class="productName">{{this.name}}</p>
                <p class="productPrice">{{this.price}}</p>
            </div>
        {{/each}}
    {{else}}
        <p class="UserComment">No tienes permisos para ver la lista</p>
    {{/if}}
</div>
<script src="/js/script.js"></script>